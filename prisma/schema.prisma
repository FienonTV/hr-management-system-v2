generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// CORE: Tenant
// ------------------------------------------------------------------

model Tenant {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  externalId String   @unique // Firmen-ID fürs Login
  logoUrl    String?
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  users               User[]
  settings            TenantSetting[]
  modules             TenantModule[]
  files               File[]
  documentContainers  DocumentContainer[]
  auditLogs           AuditLog[]
  roles               Role[]
  employees           Employee[]
  invitationTokens    InvitationToken[]
  documentCategories DocumentCategory[]
  documentTemplates  DocumentTemplate[]
  departments        Department[]
  positions          Position[]
  payGrades          PayGrade[]
  customFieldDefinitions CustomFieldDefinition[]
  qualifications     Qualification[]
  employeeQualifications EmployeeQualification[]
  calendarEvents     CalendarEvent[]
  absenceRequests    AbsenceRequest[]
  projects           Project[]
  projectEmployees   ProjectEmployee[]
  projectMilestones  ProjectMilestone[]
  projectMaterials   ProjectMaterial[]
  projectCustomValues ProjectCustomValue[]
  projectLayouts     ProjectLayout[]
  timeEntries        TimeEntry[]
  payrollExports     PayrollExport[]
  wooCommerceOrders  WooCommerceOrder[]
  wooCommerceSettings WooCommerceSetting[]
  emailSettings      EmailSetting[]
  vehicles           Vehicle[]
  dailyPlans         DailyPlan[]

  @@map("tenants")
}

model TenantSetting {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  key         String
  value       String
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

// ------------------------------------------------------------------
// CORE: Identity & Access
// ------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  employeeId          String?   @unique @map("employee_id")
  email               String
  passwordHash        String?
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  isActive            Boolean   @default(true)
  isSystemAdmin       Boolean   @default(false)
  forcePasswordChange Boolean   @default(false) @map("force_password_change")
  emailVerified       DateTime? @map("email_verified")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles       UserRole[]
  permissions UserPermission[]
  files       File[]
  auditLogs   AuditLog[]
  requestedAbsences AbsenceRequest[] @relation("RequestedAbsences")
  approvedAbsences  AbsenceRequest[] @relation("ApprovedAbsences")
  approvedTimeEntries TimeEntry[]
  createdDailyPlans DailyPlan[] @relation("DailyPlanCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([employeeId])
  @@map("users")
}

// ------------------------------------------------------------------
// CORE: Permissions & Roles
// ------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId, isAdmin])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")
  roleId   String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model UserPermission {
  id           String  @id @default(cuid())
  tenantId     String  @map("tenant_id")
  userId       String  @map("user_id")
  permissionId String  @map("permission_id")
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, permissionId])
  @@index([tenantId])
  @@map("user_permissions")
}

// ------------------------------------------------------------------
// CORE: Files
// ------------------------------------------------------------------

enum FileCategory {
  AVATAR
  CONTRACT
  PAYSLIP
  DOCUMENT
  CERTIFICATE
  OTHER

  @@map("file_category")
}

model DocumentCategory {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  color       String    @default("#3B82F6")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  files  FileDocumentCategory[]
  templates DocumentTemplate[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("document_categories")
}

// ------------------------------------------------------------------
// CORE: Files
// ------------------------------------------------------------------

model File {
  id                String       @id @default(cuid())
  tenantId          String       @map("tenant_id")
  employeeId        String?      @map("employee_id")
  uploadedById      String?      @map("uploaded_by_id")
  title             String       @default("") // display title independent of original file name
  originalName      String
  storageKey        String       @unique
  mimeType          String
  sizeBytes         Int
  checksum          String?
  isPublic          Boolean      @default(false)
  expiresAt         DateTime?
  notes             String?
  snoozedUntil      DateTime?    @map("snoozed_until")
  metadata          Json?
  textContent       String?      @map("text_content")
  category          FileCategory @default(OTHER)
  parentType        String?      @map("parent_type") // e.g. "employee", "tenant", "contract", "documentTemplate"
  parentId          String?      @map("parent_id")
  version           Int          @default(1)
  versionOfId       String?      @map("version_of_id") // legacy self-referential version chain; prefer containerId
  isLatestVersion   Boolean      @default(true) @map("is_latest_version")
  containerId       String?      @map("container_id")
  isDeleted         Boolean      @default(false)
  deletedAt         DateTime?    @map("deleted_at")
  deletedById       String?      @map("deleted_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy        User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  employee          Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  container         DocumentContainer?    @relation("ContainerFiles", fields: [containerId], references: [id], onDelete: SetNull)
  versions          File[]                  @relation("FileVersions")
  versionOf         File?                   @relation("FileVersions", fields: [versionOfId], references: [id], onDelete: SetNull)
  documentCategories FileDocumentCategory[]
  employeeQualifications EmployeeQualification[]
  project           Project?                @relation("ProjectFiles", fields: [projectId], references: [id], onDelete: SetNull)

  projectId         String?      @map("project_id")

  @@index([tenantId])
  @@index([tenantId, storageKey])
  @@index([tenantId, uploadedById])
  @@index([tenantId, employeeId])
  @@index([tenantId, containerId])
  @@index([tenantId, parentType, parentId])
  @@index([tenantId, category])
  @@index([tenantId, isDeleted])
  @@index([versionOfId])
  @@map("files")
}

model DocumentContainer {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  employeeId   String?  @map("employee_id")
  title        String
  notes        String?
  expiresAt    DateTime?
  snoozedUntil DateTime? @map("snoozed_until")
  category     FileCategory @default(OTHER)
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime? @map("deleted_at")
  deletedById  String?  @map("deleted_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  files      File[]     @relation("ContainerFiles")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, isDeleted])
  @@index([tenantId, category])
  @@map("document_containers")
}

model FileDocumentCategory {
  id          String @id @default(cuid())
  fileId      String @map("file_id")
  categoryId  String @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")

  file      File             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  category  DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([fileId, categoryId])
  @@index([fileId])
  @@index([categoryId])
  @@map("file_document_categories")
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  content     String   @db.Text // HTML body with {{variable}} placeholders
  variables   String[] @default([])
  categoryId  String?  @map("category_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
  @@map("document_templates")
}

// ------------------------------------------------------------------
// CORE: Audit Log
// ------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  userId       String?  @map("user_id")
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ------------------------------------------------------------------
// CORE: Module Registry
// ------------------------------------------------------------------

model ModuleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  version     String   @default("1.0.0")
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  tenantModules TenantModule[]

  @@map("module_definitions")
}

model TenantModule {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  moduleId  String   @map("module_id")
  isActive  Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ------------------------------------------------------------------
// MODULE: Employees
// ------------------------------------------------------------------

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
  TERMINATED

  @@map("employment_status")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERN
  APPRENTICE

  @@map("employment_type")
}

enum Gender {
  MALE
  FEMALE
  DIVERSE
  NOT_SPECIFIED

  @@map("gender")
}

model Employee {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  employeeNumber String?          @map("employee_number")
  firstName      String           @map("first_name")
  lastName       String           @map("last_name")
  email          String?
  phone          String?
  positionId     String?          @map("position_id")
  departmentId   String?          @map("department_id")
  payGradeId     String?          @map("pay_grade_id")
  employmentType EmploymentType?  @map("employment_type")
  status         EmploymentStatus @default(ACTIVE)
  birthDate      DateTime?        @map("birth_date")
  gender         Gender           @default(NOT_SPECIFIED)
  startDate      DateTime?        @map("start_date")
  exitDate       DateTime?        @map("exit_date")
  hourlyWage     Decimal?         @map("hourly_wage") @db.Decimal(10, 2)
  vacationDays   Int?           @map("vacation_days")
  probationEndDate DateTime?      @map("probation_end_date")
  fixedTermEndDate DateTime?      @map("fixed_term_end_date")
  keyNumber      String?          @map("key_number")
  chipNumber     String?          @map("chip_number")
  driverLicenseClasses String?  @map("driver_license_classes")
  forkliftLicense Boolean?       @map("forklift_license")
  address        Json?
  sensitiveData  Json?            @map("sensitive_data") // taxId, socialSecurity, iban, bic, emergencyContact etc.
  customFields   Json?            @map("custom_fields") // user-defined field values
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAccount User?
  files       File[]
  documentContainers DocumentContainer[]
  department  Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position    Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  payGrade    PayGrade?            @relation(fields: [payGradeId], references: [id], onDelete: SetNull)
  qualifications EmployeeQualification[]
  calendarEvents CalendarEvent[]
  absenceRequests AbsenceRequest[]
  projectEmployees ProjectEmployee[]
  timeEntries     TimeEntry[]
  planningAssignments DailyPlanAssignment[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, positionId])
  @@index([tenantId, lastName])
  @@map("employees")
}

// ------------------------------------------------------------------
// MODULE: Calendar + Absences
// ------------------------------------------------------------------

enum CalendarEventType {
  WORK
  ABSENCE
  MEETING
  HOLIDAY

  @@map("calendar_event_type")
}

enum AbsenceType {
  VACATION
  SICK
  PARENTAL
  UNPAID
  OTHER

  @@map("absence_type")
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("absence_status")
}

model CalendarEvent {
  id          String            @id @default(cuid())
  tenantId    String            @map("tenant_id")
  title       String
  startAt     DateTime          @map("start_at")
  endAt       DateTime          @map("end_at")
  allDay      Boolean           @default(false) @map("all_day")
  description String?
  type        CalendarEventType @default(WORK)
  employeeId  String?           @map("employee_id")
  absenceId   String?           @map("absence_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  absence  AbsenceRequest? @relation(fields: [absenceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, employeeId])
  @@index([tenantId, type])
  @@map("calendar_events")
}

model AbsenceRequest {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  employeeId    String        @map("employee_id")
  type          AbsenceType
  startAt       DateTime      @map("start_at")
  endAt         DateTime      @map("end_at")
  status        AbsenceStatus @default(PENDING)
  requestedById String?       @map("requested_by_id")
  approvedById  String?       @map("approved_by_id")
  approvedAt    DateTime?     @map("approved_at")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("RequestedAbsences", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?  @relation("ApprovedAbsences", fields: [approvedById], references: [id], onDelete: SetNull)
  calendarEvents CalendarEvent[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("absence_requests")
}

// ------------------------------------------------------------------
// MODULE: Qualifications
// ------------------------------------------------------------------

model Qualification {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  name            String
  issuer          String?
  description     String?
  validityInMonths Int?     @map("validity_in_months")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeQualifications EmployeeQualification[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("qualifications")
}

model EmployeeQualification {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  employeeId        String    @map("employee_id")
  qualificationId   String    @map("qualification_id")
  issuedAt          DateTime? @map("issued_at")
  expiresAt         DateTime? @map("expires_at")
  certificateFileId String?   @map("certificate_file_id")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  certificate   File?        @relation(fields: [certificateFileId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, qualificationId])
  @@index([tenantId, expiresAt])
  @@map("employee_qualifications")
}

// ------------------------------------------------------------------
// MODULE: Invitations
// ------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

model InvitationToken {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  email       String
  roleIds     String[]         @map("role_ids")
  invitedById String?          @map("invited_by_id")
  employeeId  String?          @map("employee_id")
  tokenHash   String           @map("token_hash") // bcrypt hash of the random token
  expiresAt   DateTime         @map("expires_at")
  status      InvitationStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tokenHash])
  @@index([tenantId, email, status])
  @@index([tenantId, status])
  @@map("invitation_tokens")
}

// ------------------------------------------------------------------
// MODULE: Employee Master Data Catalogs
// ------------------------------------------------------------------

model Department {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  code        String?
  description String?
  managerId   String?   @map("manager_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("departments")
}

model Position {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  code        String?
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("positions")
}

model PayGrade {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  name         String
  code         String?
  description  String?
  tariffGroup  String?   @map("tariff_group")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("pay_grades")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT

  @@map("custom_field_type")
}

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  appliesTo   String          @map("applies_to") // e.g. "employee", "project"
  key         String
  name        String
  description String?
  fieldType   CustomFieldType @map("field_type")
  isRequired  Boolean         @default(false) @map("is_required")
  options     Json?           // { values: string[] } for SELECT / MULTI_SELECT
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectCustomValues ProjectCustomValue[]

  @@unique([tenantId, appliesTo, key])
  @@index([tenantId, appliesTo, isActive])
  @@map("custom_field_definitions")
}

// ------------------------------------------------------------------
// MODULE: Projects + Resource Planning
// ------------------------------------------------------------------

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum ProjectMilestoneStatus {
  OPEN
  DONE

  @@map("project_milestone_status")
}

enum ProjectMaterialStatus {
  ORDERED
  DELIVERED
  USED

  @@map("project_material_status")
}

model Project {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  code          String?
  name          String
  description   String?
  status        ProjectStatus @default(PLANNED)
  availableForPlanning Boolean @default(false) @map("available_for_planning")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  customerName  String?       @map("customer_name")
  customerEmail String?       @map("customer_email")
  address       String?
  budget        Decimal?      @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees  ProjectEmployee[]
  milestones ProjectMilestone[]
  materials  ProjectMaterial[]
  timeEntries TimeEntry[]
  files      File[]            @relation("ProjectFiles")
  dailyPlanSites DailyPlanSite[]
  customValues ProjectCustomValue[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startDate])
  @@map("projects")
}

model ProjectCustomValue {
  id              String @id @default(cuid())
  tenantId        String @map("tenant_id")
  projectId       String @map("project_id")
  definitionId    String @map("definition_id")
  valueText       String? @map("value_text")
  valueNumber     Decimal? @map("value_number") @db.Decimal(12, 4)
  valueDate       DateTime? @map("value_date")
  valueBoolean    Boolean? @map("value_boolean")
  valueJson       Json?     // SELECT / MULTI_SELECT
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, definitionId])
  @@index([tenantId, projectId])
  @@map("project_custom_values")
}

model ProjectLayout {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  tabs      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@map("project_layouts")
}

model ProjectEmployee {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  projectId  String     @map("project_id")
  employeeId String     @map("employee_id")
  role       String     @default("Mitarbeiter")
  startAt    DateTime?  @map("start_at")
  endAt      DateTime?  @map("end_at")
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, employeeId])
  @@index([tenantId, projectId])
  @@index([tenantId, employeeId])
  @@map("project_employees")
}

model ProjectMilestone {
  id          String                  @id @default(cuid())
  tenantId    String                  @map("tenant_id")
  projectId   String                  @map("project_id")
  title       String
  plannedDate DateTime?               @map("planned_date")
  actualDate  DateTime?               @map("actual_date")
  status      ProjectMilestoneStatus  @default(OPEN)
  sortOrder   Int                     @default(0) @map("sort_order")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@index([tenantId, projectId, status])
  @@map("project_milestones")
}

model ProjectMaterial {
  id                 String                @id @default(cuid())
  tenantId           String                @map("tenant_id")
  projectId          String                @map("project_id")
  wooCommerceOrderId String?               @map("woocommerce_order_id")
  name               String
  quantity           Decimal?              @db.Decimal(10, 3)
  unit               String?
  status             ProjectMaterialStatus @default(ORDERED)
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@index([tenantId, wooCommerceOrderId])
  @@map("project_materials")
}

// ------------------------------------------------------------------
// MODULE: Time Tracking
// ------------------------------------------------------------------

enum TimeEntryType {
  REGULAR
  OVERTIME
  TRAVEL
  BREAK

  @@map("time_entry_type")
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED

  @@map("time_entry_status")
}

model TimeEntry {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  employeeId  String          @map("employee_id")
  projectId   String?         @map("project_id")
  date        DateTime
  hours       Decimal         @db.Decimal(5, 2)
  description String?
  type        TimeEntryType   @default(REGULAR)
  status      TimeEntryStatus @default(DRAFT)
  approvedById String?        @map("approved_by_id")
  approvedAt  DateTime?       @map("approved_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  approvedBy User?  @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, projectId])
  @@index([tenantId, date])
  @@map("time_entries")
}

// ------------------------------------------------------------------
// MODULE: Payroll Export
// ------------------------------------------------------------------

model PayrollExport {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  year        Int
  month       Int
  fileId      String?  @map("file_id")
  generatedById String? @map("generated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, year, month])
  @@map("payroll_exports")
}

// ------------------------------------------------------------------
// MODULE: WooCommerce Integration
// ------------------------------------------------------------------

model WooCommerceSetting {
  id            String  @id @default(cuid())
  tenantId      String  @map("tenant_id") @unique
  storeUrl      String  @map("store_url")
  consumerKey   String  @map("consumer_key") // encrypted
  consumerSecret String @map("consumer_secret") // encrypted
  isActive      Boolean @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders  WooCommerceOrder[]

  @@index([tenantId, isActive])
  @@map("woocommerce_settings")
}

model WooCommerceOrder {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  externalOrderId String  @map("external_order_id")
  orderNumber   String?   @map("order_number")
  status        String
  total         Decimal?  @db.Decimal(12, 2)
  currency      String?
  customerName  String?   @map("customer_name")
  customerEmail String?   @map("customer_email")
  dateCreated   DateTime? @map("date_created")
  rawData       Json?     @map("raw_data")
  syncedAt      DateTime  @default(now()) @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setting  WooCommerceSetting @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, map: "woocommerce_orders_setting_fkey")

  @@unique([tenantId, externalOrderId])
  @@index([tenantId, status])
  @@index([tenantId, dateCreated])
  @@map("woocommerce_orders")
}

// ------------------------------------------------------------------
// MODULE: Email Settings
// ------------------------------------------------------------------

model EmailSetting {
  id            String  @id @default(cuid())
  tenantId      String  @map("tenant_id") @unique
  smtpHost      String? @map("smtp_host")
  smtpPort      Int?    @map("smtp_port")
  smtpUser      String? @map("smtp_user")
  smtpPassword  String? @map("smtp_password") // encrypted
  smtpSecure    Boolean @default(false) @map("smtp_secure")
  imapHost      String? @map("imap_host")
  imapPort      Int?    @map("imap_port")
  imapUser      String? @map("imap_user")
  imapPassword  String? @map("imap_password") // encrypted
  imapSecure    Boolean @default(true) @map("imap_secure")
  fromAddress   String? @map("from_address")
  fromName      String? @map("from_name")
  isActive      Boolean @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("email_settings")
}

// ------------------------------------------------------------------
// MODULE: Vehicles
// ------------------------------------------------------------------

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_ORDER

  @@map("vehicle_status")
}

model Vehicle {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  name        String
  licensePlate String?      @map("license_plate")
  status      VehicleStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("vehicles")
}

// ------------------------------------------------------------------
// MODULE: Daily Planning
// ------------------------------------------------------------------

enum DailyPlanStatus {
  DRAFT
  PUBLISHED

  @@map("daily_plan_status")
}

model DailyPlan {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  date        DateTime        @db.Date
  status      DailyPlanStatus @default(DRAFT)
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("DailyPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sites    DailyPlanSite[]

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("daily_plans")
}

model DailyPlanSite {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  planId        String   @map("plan_id")
  projectId     String?  @map("project_id")
  name          String?
  location      String?
  startTime     String?  @map("start_time") // HH:MM
  endTime       String?  @map("end_time")   // HH:MM
  vehiclePlates String[] @map("vehicle_plates") // PostgreSQL text[]
  sortOrder     Int      @default(0) @map("sort_order")
  notes         String?

  plan        DailyPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignments DailyPlanAssignment[]

  @@index([tenantId, planId])
  @@index([tenantId, projectId])
  @@map("daily_plan_sites")
}

model DailyPlanAssignment {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  siteId     String    @map("site_id")
  employeeId String?   @map("employee_id")
  startAt    DateTime? @map("start_at")
  endAt      DateTime? @map("end_at")
  notes      String?

  site     DailyPlanSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  employee Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, siteId])
  @@index([tenantId, employeeId])
  @@map("daily_plan_assignments")
}
