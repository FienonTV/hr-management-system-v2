    "@tiptap/extension-text-style": "^3.29.0",
    "@tiptap/extension-underline": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.31",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
